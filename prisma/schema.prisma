// prisma/schema.prisma

generator client {
  provider = "prisma-client-js" // Corrigido de "prisma-client" para "prisma-client-js"
  output   = "../src/generated/prisma" 
}

datasource db {
  provider = "postgresql"
}

model Driver {
  id         String     @id @default(uuid())
  name       String
  email      String     @unique
  password   String
  phone      String
  deliveries Delivery[] 
  profile    DriverProfile?
  createdAt  DateTime   @default(now())
  status     String     @default("AVAILABLE")
}

model User {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  passwordHash    String
  role            String           @default("DRIVER")
  status          String           @default("ACTIVE")
  driverProfile   DriverProfile?
  refreshSessions RefreshSession[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model DriverProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  driverId         String?  @unique
  driver           Driver?  @relation(fields: [driverId], references: [id])
  employeeId       String?  @unique
  phone            String   @default("")
  document         String?
  status           String   @default("AVAILABLE")
  currentVehicleId String?
  operationalData  Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model RefreshSession {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  tokenHash    String    @unique
  userAgent    String?
  ipHash       String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  replacedById String?
}

model Vehicle {
  id         String     @id @default(uuid())
  plate      String     @unique 
  model      String     
  capacity   Float      
  isActive   Boolean    @default(true)
  deliveries Delivery[] 
  status     String     @default("AVAILABLE")
}

model Delivery {
  id              String   @id @default(uuid())
  description     String   
  pickupAddress   String   
  deliveryAddress String   
  price           Decimal  
  status          String   @default("PENDING") // Status único mantido aqui
  proofUrl        String?  
  driverId        String
  driver          Driver   @relation(fields: [driverId], references: [id])
  vehicleId       String
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id])
  statusHistory   DeliveryStatusHistory[]
  occurrences     Occurrence[]
  proofs          DeliveryProof[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DeliveryStatusHistory {
  id              String   @id @default(uuid())
  deliveryId      String
  delivery        Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  previousStatus  String
  newStatus       String
  changedByUserId String?
  reason          String?
  requestId       String?
  correlationId   String?
  createdAt       DateTime @default(now())

  @@index([deliveryId, createdAt])
}

model Occurrence {
  id                String   @id @default(uuid())
  deliveryId        String
  delivery          Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  title             String
  description       String
  severity          String   @default("MEDIUM")
  status            String   @default("OPEN")
  integrationStatus String   @default("NOT_REQUESTED")
  retryCount        Int      @default(0)
  lastError         String?
  ticketNumber      String?
  createdByUserId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([deliveryId, createdAt])
  @@index([integrationStatus])
}

model DeliveryProof {
  id              String   @id @default(uuid())
  deliveryId      String
  delivery        Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  type            String   @default("PHOTO")
  url             String
  description     String?
  uploadedByUserId String?
  createdAt       DateTime @default(now())

  @@index([deliveryId, createdAt])
}

model OutboxEvent {
  id             String   @id @default(uuid())
  eventType      String
  eventVersion   Int
  payload        Json
  status         String   @default("PENDING")
  attempts       Int      @default(0)
  lastError      String?
  correlationId  String
  causationId    String?
  idempotencyKey String   @unique
  processedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
  @@index([correlationId])
}

model DeadLetterEvent {
  id             String   @id @default(uuid())
  outboxEventId  String?
  eventType      String
  payload        Json
  error          String
  correlationId  String
  createdAt      DateTime @default(now())

  @@index([correlationId])
}

model InboxMessage {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventType   String
  producer    String
  processedAt DateTime @default(now())
}

model ConsumerCheckpoint {
  id            String   @id @default(uuid())
  consumerName  String   @unique
  streamName    String
  lastMessageId String   @default("0-0")
  updatedAt     DateTime @updatedAt
}
