generator client {
  provider = "prisma-client-js"
  output   = "../../../apps/logipeople-api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DataClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  SENSITIVE
  RESTRICTED
}

enum PositionStatus {
  OCCUPIED
  VACANT
  FROZEN
  PLANNED
  CLOSED
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
  SUSPENDED
  PRE_HIRE
}

enum EmploymentType {
  EMPLOYEE
  CONTRACTOR
  INTERN
  APPRENTICE
  TEMPORARY
}

enum WorkScheduleStatus {
  ACTIVE
  INACTIVE
}

enum TimeEntryKind {
  CLOCK_IN
  CLOCK_OUT
  BREAK_START
  BREAK_END
  ADJUSTMENT
}

enum TimeEntrySource {
  MANUAL
  IMPORTED
  MOBILE
  WEB
  API
}

enum TimeEntryApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendancePeriodStatus {
  OPEN
  REVIEWED
  LOCKED
}

enum PayrollCycleStatus {
  DRAFT
  OPEN
  CALCULATED
  CLOSED
  REOPENED
  CANCELLED
}

enum PayrollRunStatus {
  DRAFT
  CALCULATED
  REVIEWED
  CLOSED
  REOPENED
  CANCELLED
}

enum PayrollItemType {
  EARNING
  DEDUCTION
  EMPLOYER_CHARGE
  INFORMATIONAL
}

enum PayrollItemSource {
  MANUAL
  IMPORTED
  ATTENDANCE
  BENEFITS
  CONTRACT
  ADJUSTMENT
}

enum PayrollReopeningStatus {
  REQUESTED
  APPROVED
  REJECTED
  APPLIED
}

enum PayslipStatus {
  DRAFT
  READY_FOR_REVIEW
  CANCELLED
}

enum PayslipLineType {
  EARNING
  DEDUCTION
  EMPLOYER_CHARGE
  INFORMATIONAL
}

enum BenefitPlanType {
  HEALTH
  DENTAL
  MEAL
  FOOD
  TRANSPORT
  LIFE_INSURANCE
  WELLNESS
  OTHER
}

enum BenefitPlanStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum BenefitEnrollmentStatus {
  REQUESTED
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum AbsenceRequestType {
  SICK_LEAVE
  PERSONAL_LEAVE
  UNPAID_LEAVE
  MATERNITY
  PATERNITY
  BEREAVEMENT
  OTHER
}

enum AbsenceRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum VacationPeriodStatus {
  PLANNED
  REQUESTED
  APPROVED
  TAKEN
  CANCELLED
}

enum RecruitmentOpeningStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
  CANCELLED
}

enum CandidateStatus {
  NEW
  ACTIVE
  WITHDRAWN
  HIRED
  REJECTED
}

enum JobApplicationStatus {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
  HIRED
}

enum JobApplicationSource {
  MANUAL
  REFERRAL
  INTERNAL
  JOB_BOARD
  AGENCY
  OTHER
}

enum OnboardingPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum OnboardingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  BLOCKED
  CANCELLED
}

enum OnboardingTaskOwner {
  HR
  MANAGER
  EMPLOYEE
  IT
  FACILITIES
  OTHER
}

enum PeopleRole {
  SUPER_ADMIN
  PEOPLE_ADMIN
  HR_MANAGER
  HR_ANALYST
  RECRUITER
  PAYROLL_MANAGER
  PAYROLL_ANALYST
  TIME_MANAGER
  BENEFITS_ANALYST
  MANAGER
  EMPLOYEE
  AUDITOR
  DPO
}

enum AccessScopeType {
  COMPANY
  LEGAL_ENTITY
  BRANCH
  UNIT
  DEPARTMENT
  COST_CENTER
  TEAM
  SUBORDINATES
  SELF
}

enum SensitiveFieldKey {
  SALARY
  BANK_ACCOUNTS
  DOCUMENTS
  DEPENDENTS
  MEDICAL_INFORMATION
  BIOMETRICS
  CONFIDENTIAL_EVALUATIONS
  DISCIPLINARY_MEASURES
}

model BusinessGroup {
  id        String    @id @default(uuid())
  name      String
  companies Company[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Company {
  id                 String               @id @default(uuid())
  businessGroupId    String?
  businessGroup      BusinessGroup?       @relation(fields: [businessGroupId], references: [id])
  name               String
  legalName          String
  registrationNumber String               @unique
  legalEntities      LegalEntity[]
  branches           Branch[]
  departments        Department[]
  costCenters        CostCenter[]
  teams              Team[]
  jobs               Job[]
  positions          Position[]
  employees          Employee[]
  workSchedules      WorkSchedule[]
  attendancePeriods  AttendancePeriod[]
  payrollCycles      PayrollCycle[]
  payrollRuns        PayrollRun[]
  payslips           Payslip[]
  benefitPlans       BenefitPlan[]
  absenceRequests    AbsenceRequest[]
  vacationPeriods    VacationPeriod[]
  jobOpenings        JobOpening[]
  onboardingPlans    OnboardingPlan[]
  roleAssignments    RoleAssignment[]
  accessScopes       AccessScope[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model LegalEntity {
  id                 String   @id @default(uuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id])
  name               String
  registrationNumber String   @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Branch {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  code      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
}

model Establishment {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id          String                 @id @default(uuid())
  companyId   String
  company     Company                @relation(fields: [companyId], references: [id])
  name        String
  code        String
  positions   Position[]
  assignments DepartmentAssignment[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([companyId, code])
}

model CostCenter {
  id          String                 @id @default(uuid())
  companyId   String
  company     Company                @relation(fields: [companyId], references: [id])
  name        String
  code        String
  assignments CostCenterAssignment[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([companyId, code])
}

model Team {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  code      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
}

model Job {
  id          String       @id @default(uuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id])
  title       String
  code        String
  positions   Position[]
  salaryBands SalaryBand[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([companyId, code])
}

model Position {
  id                  String               @id @default(uuid())
  companyId           String
  company             Company              @relation(fields: [companyId], references: [id])
  departmentId        String
  department          Department           @relation(fields: [departmentId], references: [id])
  jobId               String?
  job                 Job?                 @relation(fields: [jobId], references: [id])
  title               String
  status              PositionStatus       @default(VACANT)
  assignments         PositionAssignment[]
  employees           Employee[]
  jobOpenings         JobOpening[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model SalaryBand {
  id            String   @id @default(uuid())
  jobId         String
  job           Job      @relation(fields: [jobId], references: [id])
  name          String
  minimumAmount Decimal  @db.Decimal(14, 2)
  midpointAmount Decimal @db.Decimal(14, 2)
  maximumAmount Decimal  @db.Decimal(14, 2)
  currency      String   @default("BRL")
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WorkLocation {
  id        String   @id @default(uuid())
  name      String
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Person {
  id                 String             @id @default(uuid())
  fullName           String
  preferredName      String?
  corporateEmail     String             @unique
  personalEmail      String?
  phone              String?
  dataClassification DataClassification @default(CONFIDENTIAL)
  employee           Employee?
  addresses          EmployeeAddress[]
  emergencyContacts  EmergencyContact[]
  dependents         Dependent[]
  documents          EmployeeDocument[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Employee {
  id                    String                   @id @default(uuid())
  personId              String                   @unique
  person                Person                   @relation(fields: [personId], references: [id])
  companyId             String
  company               Company                  @relation(fields: [companyId], references: [id])
  positionId            String?
  position              Position?                @relation(fields: [positionId], references: [id])
  employeeNumber        String                   @unique
  status                EmployeeStatus           @default(ACTIVE)
  hireDate              DateTime
  profile               EmployeeProfile?
  employments           Employment[]
  contracts             EmploymentContract[]
  histories             EmploymentHistory[]
  positionAssignments   PositionAssignment[]
  departmentAssignments DepartmentAssignment[]
  managerAssignments    ManagerAssignment[]      @relation("EmployeeManagerAssignments")
  managedAssignments    ManagerAssignment[]      @relation("ManagerAssignments")
  costCenterAssignments CostCenterAssignment[]
  compensationHistory   CompensationHistory[]
  statusHistory         EmployeeStatusHistory[]
  workSchedules         WorkSchedule[]
  timeEntries           TimeEntry[]
  attendancePeriods     AttendancePeriod[]
  payrollRuns           PayrollRun[]
  payrollItems          PayrollItem[]
  payslips              Payslip[]
  payslipLines          PayslipLine[]
  benefitEnrollments    BenefitEnrollment[]
  absenceRequests       AbsenceRequest[]
  vacationPeriods       VacationPeriod[]
  onboardingPlans       OnboardingPlan[]
  onboardingTasks       OnboardingTask[]
  roleAssignments       RoleAssignment[]
  accessScopes          AccessScope[]
  fieldPermissions      FieldPermission[]
  auditLogs             AuditLog[]
  dataAccessLogs        DataAccessLog[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
}

model EmployeeProfile {
  id                 String             @id @default(uuid())
  employeeId         String             @unique
  employee           Employee           @relation(fields: [employeeId], references: [id])
  bio                String?
  dataClassification DataClassification @default(CONFIDENTIAL)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Employment {
  id            String         @id @default(uuid())
  employeeId    String
  employee      Employee       @relation(fields: [employeeId], references: [id])
  type          EmploymentType
  effectiveFrom DateTime
  effectiveTo   DateTime?
  recordedAt    DateTime       @default(now())
  recordedBy    String
  reason        String
  source        String
}

model EmploymentContract {
  id                 String             @id @default(uuid())
  employeeId         String
  employee           Employee           @relation(fields: [employeeId], references: [id])
  contractNumber     String             @unique
  type               EmploymentType
  dataClassification DataClassification @default(RESTRICTED)
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  recordedAt         DateTime           @default(now())
  recordedBy         String
  reason             String
  source             String
}

model EmploymentHistory {
  id            String   @id @default(uuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  eventType     String
  description   String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  recordedAt    DateTime @default(now())
  recordedBy    String
  reason        String
  source        String
}

model PositionAssignment {
  id            String   @id @default(uuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  positionId    String
  position      Position @relation(fields: [positionId], references: [id])
  effectiveFrom DateTime
  effectiveTo   DateTime?
  recordedAt    DateTime @default(now())
  recordedBy    String
  reason        String
  source        String
}

model DepartmentAssignment {
  id            String     @id @default(uuid())
  employeeId    String
  employee      Employee   @relation(fields: [employeeId], references: [id])
  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id])
  effectiveFrom DateTime
  effectiveTo   DateTime?
  recordedAt    DateTime   @default(now())
  recordedBy    String
  reason        String
  source        String
}

model ManagerAssignment {
  id            String   @id @default(uuid())
  employeeId    String
  employee      Employee @relation("EmployeeManagerAssignments", fields: [employeeId], references: [id])
  managerId     String
  manager       Employee @relation("ManagerAssignments", fields: [managerId], references: [id])
  effectiveFrom DateTime
  effectiveTo   DateTime?
  recordedAt    DateTime @default(now())
  recordedBy    String
  reason        String
  source        String
}

model CostCenterAssignment {
  id            String     @id @default(uuid())
  employeeId    String
  employee      Employee   @relation(fields: [employeeId], references: [id])
  costCenterId  String
  costCenter    CostCenter @relation(fields: [costCenterId], references: [id])
  effectiveFrom DateTime
  effectiveTo   DateTime?
  recordedAt    DateTime   @default(now())
  recordedBy    String
  reason        String
  source        String
}

model CompensationHistory {
  id                 String             @id @default(uuid())
  employeeId         String
  employee           Employee           @relation(fields: [employeeId], references: [id])
  baseSalary         Decimal            @db.Decimal(14, 2)
  currency           String             @default("BRL")
  dataClassification DataClassification @default(RESTRICTED)
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  recordedAt         DateTime           @default(now())
  recordedBy         String
  reason             String
  source             String
}

model EmployeeAddress {
  id                 String             @id @default(uuid())
  personId           String
  person             Person             @relation(fields: [personId], references: [id])
  addressLine        String
  city               String
  state              String
  postalCode         String
  country            String             @default("BR")
  dataClassification DataClassification @default(CONFIDENTIAL)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model EmergencyContact {
  id                 String             @id @default(uuid())
  personId           String
  person             Person             @relation(fields: [personId], references: [id])
  name               String
  relationship       String
  phone              String
  dataClassification DataClassification @default(CONFIDENTIAL)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Dependent {
  id                 String             @id @default(uuid())
  personId           String
  person             Person             @relation(fields: [personId], references: [id])
  name               String
  relationship       String
  dataClassification DataClassification @default(SENSITIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model EmployeeDocument {
  id                 String             @id @default(uuid())
  personId           String
  person             Person             @relation(fields: [personId], references: [id])
  documentType       String
  storageKey         String
  dataClassification DataClassification @default(RESTRICTED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model EmployeeStatusHistory {
  id            String         @id @default(uuid())
  employeeId    String
  employee      Employee       @relation(fields: [employeeId], references: [id])
  status        EmployeeStatus
  effectiveFrom DateTime
  effectiveTo   DateTime?
  recordedAt    DateTime       @default(now())
  recordedBy    String
  reason        String
  source        String
}

model WorkSchedule {
  id                  String             @id @default(uuid())
  companyId           String
  company             Company            @relation(fields: [companyId], references: [id])
  employeeId          String?
  employee            Employee?          @relation(fields: [employeeId], references: [id])
  name                String
  weeklyMinutes       Int
  workDays            Int
  status              WorkScheduleStatus @default(ACTIVE)
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  recordedAt          DateTime           @default(now())
  recordedBy          String
  reason              String
  source              String
  dataClassification  DataClassification @default(CONFIDENTIAL)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([companyId, status])
  @@index([employeeId, effectiveFrom])
}

model TimeEntry {
  id                 String                  @id @default(uuid())
  employeeId         String
  employee           Employee                @relation(fields: [employeeId], references: [id])
  kind               TimeEntryKind
  occurredAt         DateTime
  source             TimeEntrySource         @default(MANUAL)
  approvalStatus     TimeEntryApprovalStatus @default(PENDING)
  approvedAt         DateTime?
  approvedBy         String?
  rejectedAt         DateTime?
  rejectedBy         String?
  rejectionReason    String?
  notes              String?
  recordedAt         DateTime                @default(now())
  recordedBy         String
  reason             String
  dataClassification DataClassification      @default(CONFIDENTIAL)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([employeeId, occurredAt])
  @@index([approvalStatus, occurredAt])
}

model AttendancePeriod {
  id                     String                 @id @default(uuid())
  companyId              String
  company                Company                @relation(fields: [companyId], references: [id])
  employeeId             String
  employee               Employee               @relation(fields: [employeeId], references: [id])
  periodStart            DateTime
  periodEnd              DateTime
  status                 AttendancePeriodStatus @default(OPEN)
  plannedMinutes         Int                    @default(0)
  workedMinutes          Int                    @default(0)
  absenceMinutes         Int                    @default(0)
  extraMinutes           Int                    @default(0)
  lockedAt               DateTime?
  lockedBy               String?
  reviewedAt             DateTime?
  reviewedBy             String?
  recordedAt             DateTime               @default(now())
  recordedBy             String
  reason                 String
  source                 String
  legalValidationPending Boolean                @default(true)
  dataClassification     DataClassification     @default(CONFIDENTIAL)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@unique([employeeId, periodStart, periodEnd])
  @@index([companyId, periodStart, periodEnd])
  @@index([status, periodEnd])
}

model PayrollCycle {
  id                     String             @id @default(uuid())
  companyId              String
  company                Company            @relation(fields: [companyId], references: [id])
  name                   String
  referenceMonth         Int
  referenceYear          Int
  periodStart            DateTime
  periodEnd              DateTime
  status                 PayrollCycleStatus @default(DRAFT)
  legalValidationPending Boolean            @default(true)
  closedAt               DateTime?
  closedBy               String?
  reopenedAt             DateTime?
  reopenedBy             String?
  recordedAt             DateTime           @default(now())
  recordedBy             String
  reason                 String
  source                 String
  runs                   PayrollRun[]
  reopenings             PayrollReopening[]
  dataClassification     DataClassification @default(RESTRICTED)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@unique([companyId, referenceMonth, referenceYear])
  @@index([companyId, status])
}

model PayrollRun {
  id                     String             @id @default(uuid())
  cycleId                String
  cycle                  PayrollCycle       @relation(fields: [cycleId], references: [id])
  companyId              String
  company                Company            @relation(fields: [companyId], references: [id])
  employeeId             String
  employee               Employee           @relation(fields: [employeeId], references: [id])
  status                 PayrollRunStatus   @default(DRAFT)
  grossAmount            Decimal            @default(0) @db.Decimal(14, 2)
  deductionAmount        Decimal            @default(0) @db.Decimal(14, 2)
  netAmount              Decimal            @default(0) @db.Decimal(14, 2)
  currency               String             @default("BRL")
  legalValidationPending Boolean            @default(true)
  calculatedAt           DateTime?
  reviewedAt             DateTime?
  reviewedBy             String?
  closedAt               DateTime?
  closedBy               String?
  recordedAt             DateTime           @default(now())
  recordedBy             String
  reason                 String
  source                 String
  items                  PayrollItem[]
  payslip                Payslip?
  dataClassification     DataClassification @default(RESTRICTED)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@unique([cycleId, employeeId])
  @@index([companyId, status])
  @@index([employeeId, status])
}

model PayrollItem {
  id                     String             @id @default(uuid())
  runId                  String
  run                    PayrollRun         @relation(fields: [runId], references: [id])
  employeeId             String
  employee               Employee           @relation(fields: [employeeId], references: [id])
  type                   PayrollItemType
  source                 PayrollItemSource  @default(MANUAL)
  code                   String
  description            String
  quantity               Decimal?           @db.Decimal(14, 4)
  amount                 Decimal            @db.Decimal(14, 2)
  currency               String             @default("BRL")
  taxable                Boolean            @default(false)
  legalValidationPending Boolean            @default(true)
  recordedAt             DateTime           @default(now())
  recordedBy             String
  reason                 String
  dataClassification     DataClassification @default(RESTRICTED)
  payslipLines           PayslipLine[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([runId, type])
  @@index([employeeId, code])
}

model PayrollReopening {
  id                 String                 @id @default(uuid())
  cycleId            String
  cycle              PayrollCycle           @relation(fields: [cycleId], references: [id])
  status             PayrollReopeningStatus @default(REQUESTED)
  requestedBy        String
  requestedAt        DateTime               @default(now())
  approvedBy         String?
  approvedAt         DateTime?
  appliedBy          String?
  appliedAt          DateTime?
  reason             String
  dataClassification DataClassification     @default(RESTRICTED)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([cycleId, status])
}

model Payslip {
  id                     String             @id @default(uuid())
  payrollRunId           String             @unique
  payrollRun             PayrollRun         @relation(fields: [payrollRunId], references: [id])
  companyId              String
  company                Company            @relation(fields: [companyId], references: [id])
  employeeId             String
  employee               Employee           @relation(fields: [employeeId], references: [id])
  status                 PayslipStatus      @default(DRAFT)
  referenceMonth         Int
  referenceYear          Int
  grossAmount            Decimal            @default(0) @db.Decimal(14, 2)
  deductionAmount        Decimal            @default(0) @db.Decimal(14, 2)
  netAmount              Decimal            @default(0) @db.Decimal(14, 2)
  currency               String             @default("BRL")
  visibleToEmployee      Boolean            @default(false)
  publishedAt            DateTime?
  cancelledAt            DateTime?
  cancelledBy            String?
  recordedAt             DateTime           @default(now())
  recordedBy             String
  reason                 String
  source                 String
  legalValidationPending Boolean            @default(true)
  dataClassification     DataClassification @default(RESTRICTED)
  lines                  PayslipLine[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([companyId, status])
  @@index([employeeId, referenceYear, referenceMonth])
}

model PayslipLine {
  id                     String             @id @default(uuid())
  payslipId              String
  payslip                Payslip            @relation(fields: [payslipId], references: [id])
  payrollItemId          String?
  payrollItem            PayrollItem?       @relation(fields: [payrollItemId], references: [id])
  employeeId             String
  employee               Employee           @relation(fields: [employeeId], references: [id])
  type                   PayslipLineType
  code                   String
  description            String
  quantity               Decimal?           @db.Decimal(14, 4)
  amount                 Decimal            @db.Decimal(14, 2)
  currency               String             @default("BRL")
  legalValidationPending Boolean            @default(true)
  recordedAt             DateTime           @default(now())
  recordedBy             String
  reason                 String
  dataClassification     DataClassification @default(RESTRICTED)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([payslipId, type])
  @@index([employeeId, code])
}

model BenefitPlan {
  id                     String             @id @default(uuid())
  companyId              String
  company                Company            @relation(fields: [companyId], references: [id])
  name                   String
  providerName           String
  type                   BenefitPlanType
  status                 BenefitPlanStatus  @default(DRAFT)
  employerCostAmount     Decimal            @default(0) @db.Decimal(14, 2)
  employeeCostAmount     Decimal            @default(0) @db.Decimal(14, 2)
  currency               String             @default("BRL")
  effectiveFrom          DateTime
  effectiveTo            DateTime?
  recordedAt             DateTime           @default(now())
  recordedBy             String
  reason                 String
  source                 String
  legalValidationPending Boolean            @default(true)
  dataClassification     DataClassification @default(RESTRICTED)
  enrollments            BenefitEnrollment[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([companyId, status])
  @@index([type, status])
}

model BenefitEnrollment {
  id                     String                  @id @default(uuid())
  planId                 String
  plan                   BenefitPlan             @relation(fields: [planId], references: [id])
  employeeId             String
  employee               Employee                @relation(fields: [employeeId], references: [id])
  status                 BenefitEnrollmentStatus @default(REQUESTED)
  coverageLevel          String
  employeeCostAmount     Decimal                 @default(0) @db.Decimal(14, 2)
  employerCostAmount     Decimal                 @default(0) @db.Decimal(14, 2)
  currency               String                  @default("BRL")
  effectiveFrom          DateTime
  effectiveTo            DateTime?
  recordedAt             DateTime                @default(now())
  recordedBy             String
  reason                 String
  source                 String
  legalValidationPending Boolean                 @default(true)
  dataClassification     DataClassification      @default(RESTRICTED)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([employeeId, status])
  @@index([planId, status])
  @@index([effectiveFrom, effectiveTo])
}

model AbsenceRequest {
  id                     String               @id @default(uuid())
  companyId              String
  company                Company              @relation(fields: [companyId], references: [id])
  employeeId             String
  employee               Employee             @relation(fields: [employeeId], references: [id])
  type                   AbsenceRequestType
  status                 AbsenceRequestStatus @default(REQUESTED)
  startDate              DateTime
  endDate                DateTime
  totalDays              Int
  notes                  String?
  reviewedAt             DateTime?
  reviewedBy             String?
  recordedAt             DateTime             @default(now())
  recordedBy             String
  reason                 String
  source                 String
  legalValidationPending Boolean              @default(true)
  dataClassification     DataClassification   @default(CONFIDENTIAL)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([companyId, status])
  @@index([employeeId, startDate, endDate])
}

model VacationPeriod {
  id                     String               @id @default(uuid())
  companyId              String
  company                Company              @relation(fields: [companyId], references: [id])
  employeeId             String
  employee               Employee             @relation(fields: [employeeId], references: [id])
  accrualStart           DateTime
  accrualEnd             DateTime
  periodStart            DateTime
  periodEnd              DateTime
  days                   Int
  status                 VacationPeriodStatus @default(PLANNED)
  notes                  String?
  approvedAt             DateTime?
  approvedBy             String?
  recordedAt             DateTime             @default(now())
  recordedBy             String
  reason                 String
  source                 String
  legalValidationPending Boolean              @default(true)
  dataClassification     DataClassification   @default(CONFIDENTIAL)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([companyId, status])
  @@index([employeeId, periodStart, periodEnd])
}

model JobOpening {
  id                     String                   @id @default(uuid())
  companyId              String
  company                Company                  @relation(fields: [companyId], references: [id])
  positionId             String?
  position               Position?                @relation(fields: [positionId], references: [id])
  title                  String
  description            String
  status                 RecruitmentOpeningStatus @default(DRAFT)
  targetOpenings         Int                      @default(1)
  effectiveFrom          DateTime
  effectiveTo            DateTime?
  recordedAt             DateTime                 @default(now())
  recordedBy             String
  reason                 String
  source                 String
  legalValidationPending Boolean                  @default(true)
  dataClassification     DataClassification       @default(INTERNAL)
  applications           JobApplication[]
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@index([companyId, status])
  @@index([positionId, status])
}

model Candidate {
  id                     String             @id @default(uuid())
  fullName               String
  email                  String             @unique
  phone                  String?
  status                 CandidateStatus    @default(NEW)
  consentRecordedAt      DateTime?
  recordedAt             DateTime           @default(now())
  recordedBy             String
  reason                 String
  source                 String
  dataClassification     DataClassification @default(CONFIDENTIAL)
  applications           JobApplication[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([status, createdAt])
}

model JobApplication {
  id                     String               @id @default(uuid())
  openingId              String
  opening                JobOpening           @relation(fields: [openingId], references: [id])
  candidateId            String
  candidate              Candidate            @relation(fields: [candidateId], references: [id])
  status                 JobApplicationStatus @default(APPLIED)
  source                 JobApplicationSource @default(MANUAL)
  appliedAt              DateTime             @default(now())
  notes                  String?
  reviewedAt             DateTime?
  reviewedBy             String?
  recordedAt             DateTime             @default(now())
  recordedBy             String
  reason                 String
  legalValidationPending Boolean              @default(true)
  dataClassification     DataClassification   @default(CONFIDENTIAL)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@unique([openingId, candidateId])
  @@index([openingId, status])
  @@index([candidateId, status])
}

model OnboardingPlan {
  id                     String               @id @default(uuid())
  companyId              String
  company                Company              @relation(fields: [companyId], references: [id])
  employeeId             String
  employee               Employee             @relation(fields: [employeeId], references: [id])
  name                   String
  status                 OnboardingPlanStatus @default(DRAFT)
  startDate              DateTime
  targetEndDate          DateTime?
  completedAt            DateTime?
  recordedAt             DateTime             @default(now())
  recordedBy             String
  reason                 String
  source                 String
  legalValidationPending Boolean              @default(true)
  dataClassification     DataClassification   @default(CONFIDENTIAL)
  tasks                  OnboardingTask[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([companyId, status])
  @@index([employeeId, startDate])
}

model OnboardingTask {
  id                     String                @id @default(uuid())
  planId                 String
  plan                   OnboardingPlan        @relation(fields: [planId], references: [id])
  employeeId             String
  employee               Employee              @relation(fields: [employeeId], references: [id])
  title                  String
  description            String?
  owner                  OnboardingTaskOwner   @default(HR)
  status                 OnboardingTaskStatus  @default(PENDING)
  dueDate                DateTime?
  completedAt            DateTime?
  completedBy            String?
  recordedAt             DateTime              @default(now())
  recordedBy             String
  reason                 String
  source                 String
  legalValidationPending Boolean               @default(true)
  dataClassification     DataClassification    @default(CONFIDENTIAL)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([planId, status])
  @@index([employeeId, status])
  @@index([dueDate])
}

model RoleAssignment {
  id          String     @id @default(uuid())
  employeeId  String
  employee    Employee   @relation(fields: [employeeId], references: [id])
  companyId   String?
  company     Company?   @relation(fields: [companyId], references: [id])
  role        PeopleRole
  assignedAt  DateTime   @default(now())
  assignedBy  String
  expiresAt   DateTime?
}

model AccessScope {
  id         String          @id @default(uuid())
  employeeId String
  employee   Employee        @relation(fields: [employeeId], references: [id])
  companyId  String?
  company    Company?        @relation(fields: [companyId], references: [id])
  type       AccessScopeType
  scopeId    String
  createdAt  DateTime        @default(now())
}

model FieldPermission {
  id         String            @id @default(uuid())
  employeeId String
  employee   Employee          @relation(fields: [employeeId], references: [id])
  fieldKey   SensitiveFieldKey
  canRead    Boolean           @default(false)
  canWrite   Boolean           @default(false)
  grantedAt  DateTime          @default(now())
  grantedBy  String
}

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?
  actorEmployee Employee? @relation(fields: [actorId], references: [id])
  actorRole     String
  action        String
  entityType    String
  entityId      String
  before        Json?
  after         Json?
  reason        String?
  requestId     String?
  correlationId String?
  ip            String?
  userAgent     String?
  createdAt     DateTime @default(now())
}

model DataAccessLog {
  id            String   @id @default(uuid())
  employeeId    String?
  employee      Employee? @relation(fields: [employeeId], references: [id])
  actorId       String
  entityType    String
  entityId      String
  fieldKey      String
  purpose       String
  requestId     String?
  correlationId String?
  createdAt     DateTime @default(now())
}

model OutboxEvent {
  id            String   @id @default(uuid())
  eventType     String
  eventVersion  Int      @default(1)
  payload       Json
  status        String   @default("PENDING")
  attempts      Int      @default(0)
  correlationId String?
  causationId   String?
  createdAt     DateTime @default(now())
  processedAt   DateTime?
  lastError     String?
  deadLetter    DeadLetterEvent?

  @@index([status, createdAt])
  @@index([eventType])
}

model DeadLetterEvent {
  id            String      @id @default(uuid())
  outboxEventId String      @unique
  eventType     String
  payload       Json
  error         String
  correlationId String?
  createdAt     DateTime    @default(now())
  outboxEvent   OutboxEvent @relation(fields: [outboxEventId], references: [id])
}
