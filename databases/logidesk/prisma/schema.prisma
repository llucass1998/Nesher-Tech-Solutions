generator client {
  provider = "prisma-client-js"
  output   = "../../../apps/logidesk-api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  WAITING_INTERNAL
  RESOLVED
  CLOSED
  CANCELED
  REOPENED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketSource {
  LOGIFLOW
  LOGIDESK
  EMAIL
  API
}

enum SlaStatus {
  RUNNING
  PAUSED
  WARNING
  BREACHED
  MET
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER
}

model Ticket {
  id              String                @id @default(uuid())
  number          String                @unique
  subject         String
  description     String
  status          TicketStatus          @default(OPEN)
  priority        TicketPriority        @default(MEDIUM)
  source          TicketSource          @default(LOGIDESK)
  requesterId     String?
  requesterName   String?
  requesterEmail  String?
  assigneeId      String?
  teamId          String?
  team            SupportTeam?          @relation(fields: [teamId], references: [id])
  category        String?
  categoryId      String?
  categoryRecord  TicketCategory?       @relation(fields: [categoryId], references: [id])
  externalSystem  String?
  externalId      String?
  deliveryId      String?
  occurrenceId    String?
  correlationId   String
  idempotencyKey  String?
  canceledAt      DateTime?
  archivedAt      DateTime?
  messages        TicketMessage[]
  notes           TicketNote[]
  history         TicketHistory[]
  assignments     TicketAssignment[]
  tagAssignments  TicketTagAssignment[]
  sla             TicketSla?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([externalSystem, externalId])
  @@index([status, priority])
  @@index([teamId])
  @@index([categoryId])
  @@index([correlationId])
}

model SupportTeam {
  id          String              @id @default(uuid())
  name        String              @unique
  description String?
  isActive    Boolean             @default(true)
  tickets     Ticket[]
  members     SupportTeamMember[]
  assignments TicketAssignment[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model SupportTeamMember {
  id        String      @id @default(uuid())
  teamId    String
  team      SupportTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  role      String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([teamId, userId])
  @@index([userId])
}

model TicketCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  tickets     Ticket[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TicketTag {
  id          String                @id @default(uuid())
  name        String                @unique
  description String?
  color       String?
  isActive    Boolean               @default(true)
  tickets     TicketTagAssignment[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model TicketTagAssignment {
  id        String    @id @default(uuid())
  ticketId  String
  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tagId     String
  tag       TicketTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([ticketId, tagId])
  @@index([tagId])
}

model TicketAssignment {
  id           String       @id @default(uuid())
  ticketId     String
  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assigneeId   String?
  assignedById String?
  teamId       String?
  team         SupportTeam? @relation(fields: [teamId], references: [id])
  reason       String?
  correlationId String
  createdAt    DateTime     @default(now())

  @@index([ticketId, createdAt])
  @@index([assigneeId])
  @@index([teamId])
}

model TicketMessage {
  id            String   @id @default(uuid())
  ticketId      String
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId      String?
  authorRole    String
  body          String
  internal      Boolean  @default(false)
  correlationId String
  createdAt     DateTime @default(now())

  @@index([ticketId, createdAt])
}

model TicketNote {
  id            String    @id @default(uuid())
  ticketId      String
  ticket        Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId      String?
  body          String
  correlationId String
  editedAt      DateTime?
  editedById    String?
  createdAt     DateTime  @default(now())

  @@index([ticketId, createdAt])
}

model TicketHistory {
  id             String        @id @default(uuid())
  ticketId       String
  ticket         Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  action         String
  before         Json?
  after          Json?
  previousStatus TicketStatus?
  newStatus      TicketStatus?
  actorId        String?
  actorRole      String?
  changedById    String?
  reason         String?
  requestId      String?
  correlationId  String
  createdAt      DateTime      @default(now())

  @@index([ticketId, createdAt])
  @@index([previousStatus, newStatus])
}

model SlaPolicy {
  id                         String      @id @default(uuid())
  name                       String
  priority                   TicketPriority
  firstResponseMinutes       Int
  resolutionMinutes          Int
  active                     Boolean     @default(true)
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt
}

model TicketSla {
  id                       String    @id @default(uuid())
  ticketId                 String    @unique
  ticket                   Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  status                   SlaStatus @default(RUNNING)
  firstResponseDueAt       DateTime
  resolutionDueAt          DateTime
  firstRespondedAt         DateTime?
  resolvedAt               DateTime?
  pausedAt                 DateTime?
  pausedDurationSeconds    Int       @default(0)
  warningEmittedAt         DateTime?
  breachedAt               DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model IdempotencyRecord {
  id             String   @id @default(uuid())
  key            String   @unique
  operation      String
  requestHash    String
  responseRef    String?
  correlationId  String
  createdAt      DateTime @default(now())
}

model OutboxEvent {
  id             String       @id @default(uuid())
  eventType      String
  eventVersion   Int
  payload        Json
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  lastError      String?
  correlationId  String
  causationId    String?
  processedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([correlationId])
}

model DeadLetterEvent {
  id             String   @id @default(uuid())
  outboxEventId  String?
  eventType      String
  payload        Json
  error          String
  correlationId  String
  createdAt      DateTime @default(now())

  @@index([correlationId])
}

model AuditLog {
  id             String   @id @default(uuid())
  actorId        String?
  actorRole      String?
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  requestId      String?
  correlationId  String
  createdAt      DateTime @default(now())

  @@index([entityType, entityId])
  @@index([correlationId])
}
