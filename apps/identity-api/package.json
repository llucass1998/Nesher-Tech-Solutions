{
  "name": "identity-api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "lint": "eslint src test --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config prisma.config.ts",
    "prisma:deploy": "prisma migrate deploy --config prisma.config.ts",
    "seed:admin": "ts-node src/scripts/seed-global-admin.ts"
  },
  "dependencies": {
    "@logipeople/logger": "workspace:*",
    "@nestjs/throttler": "^6.5.0",
    "otplib": "^13.4.1",
    "qrcode": "^1.5.4"
  }
}