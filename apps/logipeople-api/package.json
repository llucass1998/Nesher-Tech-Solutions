{
  "name": "logipeople-api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "lint": "eslint src test --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config prisma.config.ts",
    "prisma:deploy": "prisma migrate deploy --config prisma.config.ts",
    "seed": "tsx ../../databases/logipeople/prisma/seed/seed.ts"
  },
  "dependencies": {
    "@logipeople/auth": "workspace:*",
    "@logipeople/config": "workspace:*",
    "@logipeople/contracts": "workspace:*",
    "@logipeople/event-contracts": "workspace:*",
    "@logipeople/logger": "workspace:*"
  }
}